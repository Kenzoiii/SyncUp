# OS-specific
# ============
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS (in case collaborators use it)
.DS_Store
.AppleDouble
.LSOverride

# General
*.log
*.tmp
*.swp
*.swo
*.bak

# IDEs/editors
# ============
# VS Code
.vscode/
.code-workspace

# IntelliJ/JetBrains
.idea/
*.iml
out/

# Eclipse
.project
.classpath
.settings/

# Java / Maven / Spring Boot (backend)
# ====================================
backend/target/
backend/*.iml
backend/.idea/

# Maven Wrapper
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# Spring Boot
# Exclude packaged jars/wars created locally
backend/*.jar
backend/*.war

# Generated resources
backend/target/classes/
backend/target/test-classes/
backend/target/generated-sources/
backend/target/generated-test-sources/
backend/target/maven-status/
backend/target/maven-archiver/

# Frontend / Node / React (TypeScript)
# ====================================
frontend/node_modules/
frontend/.parcel-cache/
frontend/.next/
frontend/.nuxt/
frontend/dist/
frontend/build/
frontend/.turbo/

# Lock and environment overrides (keep only one lockfile if desired)
# Uncomment the one you want to keep tracked.
# frontend/package-lock.json
# frontend/yarn.lock
# frontend/pnpm-lock.yaml

# Test coverage & reports
frontend/coverage/
backend/coverage/

# Local environment files (do not commit secrets)
# ===============================================
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
frontend/.env*
backend/.env*

# Spring Boot application properties (contains secrets)
# Track an example/template file instead (see application-example.properties)
backend/src/main/resources/application.properties

# Misc tooling caches
# ===================
# npm/yarn/pnpm
.npm/
.yarn/
.pnp/
.pnp.js

# TypeScript
*.tsbuildinfo

# Logs
# =====
frontend/*.log
backend/*.log

# Temporary files
# ===============
.tmp/
.temp/
.cache/
